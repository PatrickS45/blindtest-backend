# ========================================
# BLINDTEST BACKEND - Configuration
# Version 2.0 - Multi-modes de jeu
# ========================================

# ==================== SERVEUR ====================
PORT=3001
NODE_ENV=development

# ==================== URLS ====================
# URL du client frontend (CORS)
# En développement:
CLIENT_URL=http://localhost:3000
# En production (remplacez par votre URL Vercel):
# CLIENT_URL=https://votre-app.vercel.app

# ==================== SPOTIFY API ====================
# Créez une application sur: https://developer.spotify.com/dashboard
# Instructions:
# 1. Créer une app
# 2. Copier Client ID et Client Secret
# 3. Pas besoin de configurer Redirect URIs (on utilise Client Credentials)

SPOTIFY_CLIENT_ID=votre_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_client_secret_ici

# ==================== LOGGING ====================
# Niveaux: error, warn, info, debug
LOG_LEVEL=info

# ==================== NOTES ====================
# - Le serveur se déploie gratuitement sur Render.com
# - Les playlists Spotify doivent être publiques
# - Rate limit: 180 requêtes Spotify/minute (géré automatiquement)
# - Les parties inactives sont supprimées après 30 minutes
