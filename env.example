# Configuration du serveur backend
PORT=3001

# URL du serveur backend (pour référence)
# En local:
SERVER_URL=http://localhost:3001
# En production:
# SERVER_URL=https://blindtest-backend-cfbp.onrender.com

# URL du client frontend (sera l'URL Vercel en production)
CLIENT_URL=http://localhost:3000

# Spotify API Credentials
# Créez une app sur https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=votre_client_id_ici
SPOTIFY_CLIENT_SECRET=votre_client_secret_ici

# Exemple en production:
# CLIENT_URL=https://votre-app.vercel.app
